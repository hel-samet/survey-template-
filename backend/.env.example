# Server
NODE_ENV=development
PORT=4000
TIMEZONE=Asia/Phnom_Penh

# Comma-separated list of allowed frontend origins ("*" allows any origin)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/survey_db
# Set to true for managed databases that require SSL (Render, Neon, Supabase…)
DATABASE_SSL=false

# Admin login (single admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Google sign-in for respondents (surveys with "Require Google sign-in").
# Firebase console → Project settings → Project ID. Leave empty to disable.
FIREBASE_PROJECT_ID=

# Optional Telegram defaults (can also be set from the admin panel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
