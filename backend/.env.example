# Server
NODE_ENV=development
PORT=4000
TIMEZONE=Asia/Phnom_Penh

# Comma-separated list of allowed frontend origins ("*" allows any origin)
CORS_ORIGIN=http://localhost:5173

# Firebase / Firestore
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on one line, or its base64 encoding:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
FIREBASE_SERVICE_ACCOUNT=
# Optional, defaults to the project_id inside the service account
FIREBASE_PROJECT_ID=
# Alternative to FIREBASE_SERVICE_ACCOUNT: path to the downloaded key file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Local emulator (firebase emulators:start --only firestore); no credentials needed
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Admin login (single admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Google sign-in for respondents (surveys with "Require Google sign-in").
# Firebase console → Project settings → Project ID. Leave empty to disable.
FIREBASE_PROJECT_ID=

# Optional Telegram defaults (can also be set from the admin panel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
