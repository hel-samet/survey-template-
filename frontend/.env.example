# Backend API base URL (include the /api suffix)
VITE_API_URL=http://localhost:4000/api

# Firebase web app config for respondent Google sign-in (public values, safe to commit).
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Public path the app is served from.
# Local dev: /    GitHub Pages project site: /<repository-name>/
VITE_BASE=/
