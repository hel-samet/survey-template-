# Backend API base URL (include the /api suffix)
VITE_API_URL=http://localhost:4000/api

# Cloudflare Turnstile CAPTCHA site key (public). Leave empty to disable the CAPTCHA.
# Test key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Public path the app is served from.
# Local dev: /    GitHub Pages project site: /<repository-name>/
VITE_BASE=/
